    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "docx": "^9.5.1",
    "fastify": "^5.2.1",
    "openai": "^7.8.0",
    "pdfkit": "^0.17.2",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
