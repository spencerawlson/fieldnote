{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fieldnote",
  "version": "0.1.0",
  "identifier": "app.fieldnote.desktop",
  "build": {
    "frontendDist": "splash",
    "beforeBuildCommand": "npm run desktop:prepare",
    "beforeDevCommand": "npm run desktop:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Turn your work notes into reports and presentations",
    "longDescription": "Fieldnote documents technical work as it happens. Paste rough notes and drop in screenshots; it structures the work, explains the technology behind each step, links evidence to the actions it proves, and generates reports, presentations, speaker notes and the questions you are likely to be asked.",
    "copyright": "",
    "licenseFile": "../LICENSE",
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../server/src": "server/src",
      "../server/package.json": "server/package.json",
      "../web/dist": "web/dist",
      "../package.json": "package.json",
      "runtime/node_modules": "node_modules",
      "runtime/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
