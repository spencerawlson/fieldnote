# ---------------------------------------------------------------------------
# Fieldnote environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
PORT=4000
# Bind address. Use 127.0.0.1 to listen only on the loopback interface (what the
# desktop build does); 0.0.0.0 to accept connections from the network.
HOST=0.0.0.0
# Public origin used for absolute links in exports. No trailing slash.
APP_URL=http://localhost:4000

# --- Security ---
# 32+ random bytes, base64 or hex. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Comma separated list of allowed browser origins for CORS/CSRF checks.
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# --- Database ---
# SQLite file path (relative paths resolve against the repo root).
DATABASE_PATH=./storage/fieldnote.db

# --- File storage ---
# Driver: local (default). S3-compatible drivers plug in via files/storage.ts.
STORAGE_DRIVER=local
STORAGE_PATH=./storage/uploads
MAX_UPLOAD_BYTES=26214400
MAX_UPLOADS_PER_PROJECT=500

# --- AI provider ---
# Provider: openai (default) | anthropic | mock.
# "mock" is deterministic and needs no API key; it is what the test-suite uses
# and it lets the whole product run offline. If the selected provider has no
# key configured, the app falls back to mock instead of failing to boot.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Override for Azure OpenAI or an OpenAI-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# Alternate provider, kept wired through the same abstraction.
ANTHROPIC_API_KEY=
# Model routing. Any workload may be pointed at a different model.
# reasoning = report/presentation/knowledge building, fast = short structured
# calls, vision = multimodal screenshot analysis + OCR.
AI_MODEL_REASONING=gpt-5
AI_MODEL_FAST=gpt-5-mini
AI_MODEL_VISION=gpt-5-mini
AI_MAX_OUTPUT_TOKENS=8000
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=2

# --- OCR ---
# ocr driver: vision (use the multimodal AI provider) | tesseract (local, requires
# the optional `tesseract.js` dependency) | none
OCR_DRIVER=vision

# --- Jobs ---
JOB_WORKER_ENABLED=true
JOB_CONCURRENCY=2
JOB_POLL_INTERVAL_MS=500

# --- Cost control ---
# Soft monthly ceiling per user in USD cents; 0 disables the check.
AI_USER_MONTHLY_CENTS=0
AI_PROJECT_MONTHLY_CENTS=0

# --- Observability ---
LOG_LEVEL=info
